<div class="{% if settings.layout_width == 'boxed' %}container{% else %}container-fluid{% endif %}">
  {% if section.settings.heading != blank or section.settings.description != blank or section.settings.subheading != blank %}
    <div class="section-heading text-{{ section.settings.alignment }} {% if section.settings.nav_style == 'arrow' %}arrow-position-{{ section.settings.arrow_position }}{% endif %}">
      {% if section.settings.subheading != blank %}
        <p class="yv-subheading yv-testimonials-subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        {% if section.settings.highlight_font == 'body' %}
          {% capture highlightStyle %}
          <span class="body-font highlighted-text">
          {% endcapture %}
        {% elsif section.settings.highlight_font == 'heading' %}
        {% capture highlightStyle %}
          <span class="heading-font highlighted-text">
        {% endcapture %}  
        {% else %}
        {% capture highlightStyle %}
          <span class="accent-font highlighted-text">
        {% endcapture %}  
        {% endif %}
        <{{ section.settings.seo_heading }} class="section-heading-title {{ section.settings.heading_size }}"
          {% if settings.enable_animation %}
            data-aos="fade-up"
          {% endif %}
        >
          {% comment %} {{ section.settings.heading | replace: "<strong>", highlightStyle | replace: "</strong>", '</span>' | replace: '++', '<br/>' }} {% endcomment %}
          {%- assign heading = section.settings.heading | replace: "<strong>", highlightStyle | replace: "</strong>", '</span>' | replace: '++', '<br/>' -%}
          {%- if heading contains '[' and heading contains ']' -%}
            {%- render 'rotational-highlight', heading: heading -%}
          {%- else -%}
            {{- heading -}}
          {%- endif -%}
        </{{ section.settings.seo_heading }}>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="yv-testimonials-desc{% if section.settings.description_size == 'h5' %} h5 default{% else %} {{ section.settings.description_size }}{% endif %}" {% if settings.enable_animation %}
          data-aos="fade-up"
        {% endif %}>
          {{ section.settings.description | newline_to_br }}
        </div>
      {% endif %}
    </div>
  {% endif %}
  {%- assign minSlide = 1 -%}
  {%- if section.settings.column_count == 'column2' -%}
    
  {%- endif -%}
  <div class="yv-testimonial-wrapper {% if section.settings.nav_style == 'arrow' %}arrows-position-{{ section.settings.arrow_position }}{% endif %} testimonial-style-{% if section.settings.slider_style == 'style1' %}classic{% elsif section.settings.slider_style == 'style2' %}modern{% elsif section.settings.slider_style == 'style4' %}verified{% else %}card{% endif %}">
    <div class="row align-items-center justify-content-center">
      {%- if section.blocks.size > 0 -%}
        <div class="remove-padding col-sm-12 {% if section.settings.column_count == 'column1' or section.settings.column_count == 'column2' and section.blocks.size == 1 %}col-md-12 col-lg-12 col-xl-12{% else %}col-md-12 col-lg-12 col-xl-12{% endif %}">
          <div
            id="testimonials-{{ section.id }}"
            class="yv-testimonial-slider{% if section.settings.column_count != 'column1' and section.blocks.size > 1 %} yv-boxtestimonial-slider{% endif %} {{ section.settings.column_count }}"
            {% if section.blocks.size > 1 %}
              data-flickity-slider='
                {
                {%- if section.settings.nav_style == 'arrow' -%}
                "prevNextButtons":true,
                "arrowShape":"M50.1228 1.62718C48.1063 -0.542395 44.8369 -0.542395 42.8204 1.62718L1.51235 46.0716C-0.504121 48.2412 -0.504121 51.7588 1.51235 53.9284L42.8204 98.3728C44.8369 100.542 48.1063 100.542 50.1228 98.3728C52.1392 96.2032 52.1392 92.6857 50.1228 90.5161L17.6293 55.5556H94.8365C97.6882 55.5556 100 53.0682 100 50C100 46.9317 97.6882 44.4444 94.8365 44.4444H17.6293L50.1228 9.48393C52.1392 7.31435 52.1392 3.79676 50.1228 1.62718Z",
                "pageDots":false,
                {%- else -%}
                "pageDots":true,
                "prevNextButtons":false,
                {%- endif -%}
                "groupCells":true,
                "cellAlign": "left",
                "resize": true, 
                "touchVerticalScroll": false,
                "wrapAround":true,
                "dragThreshold":true,
                "contain": true
                }
              '
            {% endif %}
            tabindex="0"
          >
            {%- for block in section.blocks -%}
              {%- capture authorImage -%}
                {% if block.settings.image != blank %}
                  <div class="author-img {% if section.settings.slider_style == 'style2' %}big-image{% endif %}">
                    {% render 'lazy-image', image: block.settings.image, sizes: '[100]' %}
                  </div>
                {% endif %}
              {%- endcapture -%}

              {%- capture reviewStars -%}
                <ul class="list-unstyled yv-testimonial-reviews">
                  {%- for i in (1..block.settings.rating) -%}
                    <li>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 362" width="20" height="19">
                        <path data-id="Layer_10" fill-rule="evenodd"   d="m204.7 10.5l37.5 116.1l122-0.3c15.4 0 21.2 19.1 7.7 28.9l-97.5 70.5l37.9 115.9c4.9 14.8-12.9 26.5-24.6 16.5l-97.6-71.2l-98.6 71.9c-13.4 9.7-28.2-3.4-22.6-20.4l36.9-112.7l-98.8-71.5c-12.6-9.1-5.2-28.9 10.1-27.9l120.9 0.3l37.5-116.1c4.5-14.2 24.7-14.1 29.2 0z" />
                      </svg>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endcapture -%}

              {%- capture verifiedStars -%}
                <ul class="list-unstyled yv-testimonial-reviews">
                  {%- for i in (1..5) -%}
                    <li>
                      {%- if i <= block.settings.rating -%}
                        <svg class="star-filled" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 362" width="20" height="19">
                          <path fill-rule="evenodd" d="m204.7 10.5l37.5 116.1l122-0.3c15.4 0 21.2 19.1 7.7 28.9l-97.5 70.5l37.9 115.9c4.9 14.8-12.9 26.5-24.6 16.5l-97.6-71.2l-98.6 71.9c-13.4 9.7-28.2-3.4-22.6-20.4l36.9-112.7l-98.8-71.5c-12.6-9.1-5.2-28.9 10.1-27.9l120.9 0.3l37.5-116.1c4.5-14.2 24.7-14.1 29.2 0z" />
                        </svg>
                      {%- else -%}
                        <svg class="star-empty" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 380 362" width="20" height="19">
                          <path fill-rule="evenodd" d="m204.7 10.5l37.5 116.1l122-0.3c15.4 0 21.2 19.1 7.7 28.9l-97.5 70.5l37.9 115.9c4.9 14.8-12.9 26.5-24.6 16.5l-97.6-71.2l-98.6 71.9c-13.4 9.7-28.2-3.4-22.6-20.4l36.9-112.7l-98.8-71.5c-12.6-9.1-5.2-28.9 10.1-27.9l120.9 0.3l37.5-116.1c4.5-14.2 24.7-14.1 29.2 0z" />
                        </svg>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endcapture -%}

              {%- capture verifiedRow -%}
                <div class="yv-testimonial-verified-row">
                  {% if block.settings.show_verified_badge %}
                    <span class="yv-testimonial-verified-badge">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16">
                        <circle cx="8" cy="8" r="8" fill="currentColor" />
                        <path d="M4.5 8.3l2.2 2.2 4.3-4.8" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                      {{- block.settings.verified_label -}}
                    </span>
                  {% endif %}
                  {% if block.settings.author != blank or block.settings.review_date != blank %}
                    <span class="yv-testimonial-verified-meta">
                      {{- block.settings.author -}}
                      {%- if block.settings.author != blank and block.settings.review_date != blank %} &mdash; {% endif -%}
                      {{- block.settings.review_date -}}
                    </span>
                  {% endif %}
                </div>
              {%- endcapture -%}

              {% capture authorName %}
                <p>
                  {{ block.settings.author -}}
                  {%- if block.settings.author != blank and block.settings.author_city != blank %} /{%- endif %}
                  {%- if block.settings.author_city != blank %}
                    <span>{{ block.settings.author_city }}</span>
                  {%- endif %}
                </p>
              {%  endcapture %}
              <div class="slideshow__slide--{{ block.id }} yv-testimonial-slider-item" data-testimonial-wrapper {{ block.shopify_attributes }}>
                {% if section.settings.slider_style == 'style4' %}
                  <div class="yv-testimonial-slide yv-testimonial-slide-verified text-{{ section.settings.text_alignment }}">
                    {{- verifiedStars -}}
                    <p class="yv-testimonial-review yv-testimonial-review-quoted{% if section.settings.text_size == 'h5' %} h5 default{% else %} {{ section.settings.text_size }}{% endif %}">{{ block.settings.message }}</p>
                    {{- verifiedRow -}}
                    {% if block.settings.video != blank %}
                      {% liquid
                        assign videoUrl = block.settings.video.sources[0].url
                        if block.settings.video.sources.size > 1
                        assign videoUrl = block.settings.video.sources[1].url
                        endif
                      %}
                      <testimonial-video-trigger class="testimonial-video cursor-pointer" data-url="{{ videoUrl }}">
                        <span class="testimonial-video-icon">
                          <svg width="33" height="38" viewBox="0 0 33 38" fill="none">
                            <path d="M3.3001 38C2.69618 38 2.09556 37.81 1.56425 37.4338C1.08631 37.0923 0.691864 36.6161 0.418164 36.0503C0.144463 35.4845 0.000544022 34.8476 0 34.1999V3.79939C0 2.48076 0.594018 1.25714 1.56425 0.565529C2.04324 0.226415 2.58926 0.0331475 3.15097 0.00389818C3.71268 -0.0253512 4.27163 0.110378 4.77524 0.398326L31.176 15.5986C31.7242 15.9148 32.1851 16.4004 32.5073 17.001C32.8294 17.6017 33 18.2937 33 18.9997C33 19.7056 32.8294 20.3977 32.5073 20.9983C32.1851 21.599 31.7242 22.0846 31.176 22.4007L4.77524 37.601C4.31323 37.867 3.80172 38 3.3001 38Z" fill="currentColor"></path>
                          </svg>
                        </span>
                        {% if block.settings.video_text != blank %}
                        <span>{{ block.settings.video_text }}</span>
                        {% endif %}
                      </testimonial-video-trigger>
                    {% endif %}
                  </div>
                {% else %}
                <div class="yv-testimonial-slide text-{{ section.settings.text_alignment }}">
                  {% if section.settings.slider_style == 'style2' %}
                    {% if block.settings.image != blank %}
                      <div class="yv-testimonial-author">
                        {{- authorImage -}} 
                      </div>
                    {% endif %}
                    {{- reviewStars -}}
                  {% endif %}
                  <p class="yv-testimonial-review{% if section.settings.text_size == 'h5' %} h5 default{% else %} {{ section.settings.text_size }}{% endif %}">{{ block.settings.message }}</p>
                  {% if section.settings.slider_style == 'style1' %}
                    {{- reviewStars -}}
                  {% endif %}
                  <div class="yv-testimonial-author">
                    {% if section.settings.slider_style == 'style1' or section.settings.slider_style == 'style3' %}
                      {{- authorImage -}}
                    {% endif %} 
                    {% if section.settings.slider_style == 'style3' %}
                      <div class="review-author-box">
                        {{ authorName }}
                        {{ reviewStars }}
                      </div>
                    {% else %}
                      {{ authorName }}
                    {% endif %}
                  </div>
                  {% if block.settings.video != blank %}
                    {% liquid
                      assign videoUrl = block.settings.video.sources[0].url
                      if block.settings.video.sources.size > 1
                      assign videoUrl = block.settings.video.sources[1].url
                      endif
                    %}
                     <testimonial-video-trigger class="testimonial-video cursor-pointer" data-url="{{ videoUrl }}">
                      <span class="testimonial-video-icon">
                        <svg width="33" height="38" viewBox="0 0 33 38" fill="none">
                          <path d="M3.3001 38C2.69618 38 2.09556 37.81 1.56425 37.4338C1.08631 37.0923 0.691864 36.6161 0.418164 36.0503C0.144463 35.4845 0.000544022 34.8476 0 34.1999V3.79939C0 2.48076 0.594018 1.25714 1.56425 0.565529C2.04324 0.226415 2.58926 0.0331475 3.15097 0.00389818C3.71268 -0.0253512 4.27163 0.110378 4.77524 0.398326L31.176 15.5986C31.7242 15.9148 32.1851 16.4004 32.5073 17.001C32.8294 17.6017 33 18.2937 33 18.9997C33 19.7056 32.8294 20.3977 32.5073 20.9983C32.1851 21.599 31.7242 22.0846 31.176 22.4007L4.77524 37.601C4.31323 37.867 3.80172 38 3.3001 38Z" fill="currentColor"></path>
                        </svg>
                      </span>
                      {% if block.settings.video_text != blank %}
                      <span>{{ block.settings.video_text }}</span>
                      {% endif %}
                    </testimonial-video-trigger>
                  {% endif %}
                </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }}.shopify-section {
    background:var(--{{- section.settings.bgcolor -}}ColorBody);
    padding-top:{{ section.settings.top_space_desktop }}px;
    padding-bottom:{{ section.settings.bottom_space_desktop }}px;
    {%- unless section.settings.bgcolor == 'primary' or section.settings.bgcolor == 'gradient' -%}
    --colorTextBody:var(--{{- section.settings.bgcolor -}}colorTextBody);
    --heading_color:var(--{{- section.settings.bgcolor -}}_heading_color);
    --subheading_color:var(--{{- section.settings.bgcolor -}}_subheading_color);
    --colorLightTextBody:var(--{{- section.settings.bgcolor -}}ColorLightTextBody);
    --colorXlightTextBody:var(--{{- section.settings.bgcolor -}}ColorXlightTextBody);
    {%- endunless -%}
    {% if section.settings.divider_top %}
    border-top: 1px solid #f8f8f8;
    {% endif %}
    {% if section.settings.divider_bottom %}
    border-bottom: 1px solid #f8f8f8;
    {% endif %}
    {% if section.settings.highlight_text_gradient != blank %}
      --highlightTextColor: {{ section.settings.highlight_text_gradient }};
    {% else %}
      --highlightTextColor: {{ section.settings.highlight_text_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }}.shopify-section .section-heading-title {
    --fontSize: var(--{{ section.settings.heading_size }});
  }

  #shopify-section-{{ section.id }}.shopify-section .yv-testimonials-subheading {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    {% if section.settings.subheading_color != blank %}
      color: {{ section.settings.subheading_color }};
    {% endif %}
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-slider-item {
    padding: 10px;
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-slide {
    background: {% if section.settings.card_bgcolor != blank %}{{ section.settings.card_bgcolor }}{% else %}var(--primaryCardBackground){% endif %};
    border-radius: var(--layoutRadius);
    box-shadow: none;
    min-height: auto;
    display: block;
    padding: 30px;
    margin: 0;
    max-width: none;
  }

  {% if section.settings.card_text_color != blank %}
  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-review-quoted {
    color: {{ section.settings.card_text_color }};
  }
  {% endif %}

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-reviews {
    justify-content: flex-start;
    color: {{ section.settings.card_star_color | default: '#c99a3f' }};
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-reviews svg {
    fill: currentColor;
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-reviews svg.star-empty {
    fill: none;
    stroke: currentColor;
    stroke-width: 10px;
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-review-quoted {
    margin-bottom: 24px;
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-review-quoted:before {
    content: '"';
  }

  #shopify-section-{{ section.id }}.shopify-section .testimonial-style-verified .yv-testimonial-review-quoted:after {
    content: '"';
  }

  #shopify-section-{{ section.id }}.shopify-section .yv-testimonial-verified-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 16px;
  }

  #shopify-section-{{ section.id }}.shopify-section .yv-testimonial-verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: {{ section.settings.card_badge_color | default: '#a4813f' }};
    font-weight: 600;
    font-size: var(--smallText);
  }

  #shopify-section-{{ section.id }}.shopify-section .yv-testimonial-verified-badge svg {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }}.shopify-section .yv-testimonial-verified-meta {
    color: {% if section.settings.card_text_color != blank %}{{ section.settings.card_text_color }}{% else %}var(--colorLightTextBody){% endif %};
    font-size: var(--smallText);
    opacity: {% if section.settings.card_text_color != blank %}0.7{% else %}1{% endif %};
  }

  @media only screen and (max-width:991px) {
    #shopify-section-{{ section.id }}.shopify-section{
      padding-top:{{ section.settings.top_space_mobile }}px;
      padding-bottom:{{ section.settings.bottom_space_mobile }}px;
    }
  }
  {% if section.settings.section_visibility == 'large' %}
      @media (max-width: 767px) {
        #shopify-section-{{ section.id }}{
          display: none !important;
        }
      }
    {% elsif section.settings.section_visibility == 'small' %}
      @media (min-width: 768px) {
        #shopify-section-{{ section.id }}{
          display: none !important;
        }
      }
  {% endif %}  
</style>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "class": "testimonial testimonial-section",
  "max_blocks": 5,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "default": "Why they love us",
      "label": "t:sections.testimonials.settings.subheading.label"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "t:sections.testimonials.settings.subheading_color.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Add testimonials heading here",
      "label": "t:sections.testimonials.settings.heading.label",
      "info": "t:common.highlight_text_and_break_text.info"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "t:common.highlight_text_color.label",
      "default": "#000000",
      "visible_if": "{{ section.settings.heading contains '<strong>' or section.settings.heading contains '[' and section.settings.heading contains ']' }}"
    },
    {
      "type": "color_background",
      "id": "highlight_text_gradient",
      "label": "t:common.highlight_text_gradient.label",
      "info": "t:common.highlight_text_gradient.info",
      "default": "linear-gradient(90deg, #A678C8 0%, #718CC7 48.08%, #639A47 100%)",
      "visible_if": "{{ section.settings.heading contains '<strong>' or section.settings.heading contains '[' and section.settings.heading contains ']' }}"
    },
    {
      "type": "select",
      "id": "highlight_font",
      "default": "body",
      "label": "t:common.highlight_font.label",
      "options": [
        {
          "value": "body",
          "label": "t:common.highlight_font.options.body.label"
        },
        {
          "value": "heading",
          "label": "t:common.highlight_font.options.heading.label"
        },
        {
          "value": "accent",
          "label": "t:common.highlight_font.options.accent.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "seo_heading",
      "label": "t:common.header.heading_tag.label",
      "info": "t:common.header.heading_tag.info",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:common.header.heading_tag.options.h1.label"
        },
        {
          "value": "h2",
          "label": "t:common.header.heading_tag.options.h2.label"
        },
        {
          "value": "h3",
          "label": "t:common.header.heading_tag.options.h3.label"
        },
        {
          "value": "h4",
          "label": "t:common.header.heading_tag.options.h4.label"
        },
        {
          "value": "h5",
          "label": "t:common.header.heading_tag.options.h5.label"
        },
        {
          "value": "h6",
          "label": "t:common.header.heading_tag.options.h6.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "default": "h2",
      "label": "t:common.heading_size.label",
      "options": [
        {
          "value": "h5",
          "label": "t:common.heading_size.options.small.label"
        },
        {
          "value": "h4",
          "label": "t:common.heading_size.options.medium.label"
        },
        {
          "value": "h2",
          "label": "t:common.heading_size.options.large.label"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.slider.blocks.slide.settings.banner_desc.label"
    },
    {
      "type": "select",
      "id": "description_size",
      "label": "Description text size",
      "default": "text",
      "options": [        
        {
          "label": "t:common.description.description_text_size.option2.label",
          "value": "text"
        },
        {
          "label": "t:common.description.description_text_size.option3.label",
          "value": "text-medium"
        },
        {
          "label": "t:common.description.description_text_size.option4.label",
          "value": "h6"
        },
        {
          "label": "t:common.description.description_text_size.option5.label",
          "value": "h5"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:common.header.content_alignment_section.label",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "t:common.header.content_alignment_section.options.left.label"
        },
        {
          "value": "center",
          "label": "t:common.header.content_alignment_section.options.center.label"
        }
      ]
    },
    {
      "type": "header",
