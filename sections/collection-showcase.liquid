{%- liquid
  comment
    A block is active when its collection has products, or (if no collection) its product list has products.
    Active block ids are kept as ",id1,id2," so they can be checked with `contains`.
  endcomment
  assign activeBlockIds = ','
  assign activeBlockCount = 0
  for block in section.blocks
    assign blockHasProducts = false
    if block.settings.collection != blank and block.settings.collection.products_count > 0
      assign blockHasProducts = true
    elsif block.settings.product_list != blank and block.settings.product_list.size > 0
      assign blockHasProducts = true
    endif
    if blockHasProducts
      assign activeBlockIds = activeBlockIds | append: block.id | append: ','
      assign activeBlockCount = activeBlockCount | plus: 1
    endif
  endfor
-%}
{%- if activeBlockCount > 0 -%}
{{ 'collection-showcase.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign collectionAvailable = 0
  assign anyCollectionAvailable = false
  assign customIndex = 0
  if settings.product_image_style == 'landscape'
    assign productImageRatio = 75
  elsif settings.product_image_style == 'square'
    assign productImageRatio = 100
  elsif settings.product_image_style == 'portrait'
    assign productImageRatio = 125
  endif
  if section.settings.image_height == 'landscape'
    assign imageHeight = 75
  elsif section.settings.image_height == 'portrait'
    assign imageHeight = 125
  elsif section.settings.image_height == 'square'
    assign imageHeight = 100
  endif
  assign useAspectImage = false
  if section.settings.image_height == 'aspect'
    assign useAspectImage = true
  endif
-%}
<div class="container collection-showcase-wrapper">
  <div class="row no-gutters align-items-center justify-content-between collection-showcase-header">
    <div class="col-12 col-md-7">
      {% if section.settings.subheading != blank %}
        <p class="heading-subtitle">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        {% if section.settings.highlight_font == 'body' %}
          {% capture highlightStyle %}<span class="body-font highlighted-text">{% endcapture %}
        {% elsif section.settings.highlight_font == 'heading' %}
          {% capture highlightStyle %}<span class="heading-font highlighted-text">{% endcapture %}
        {% else %}
          {% capture highlightStyle %}<span class="accent-font highlighted-text">{% endcapture %}
        {% endif %}
        <div class="section-heading">
          <{{ section.settings.seo_heading }} class="section-heading-title {{ section.settings.heading_size }}">
            {%- assign heading = section.settings.heading | replace: "<strong>", highlightStyle | replace: "</strong>", '</span>' | replace: '++', '<br/>' -%}
            {%- if heading contains '[' and heading contains ']' -%}
              {%- render 'rotational-highlight', heading: heading -%}
            {%- else -%}
              {{- heading -}}
            {%- endif -%}
          </{{ section.settings.seo_heading }}>
        </div>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="collection-showcase-description text-large">{{ section.settings.description }}</div>
      {% endif %}
    </div>
    {%- capture headerRightContent -%}
      {%- capture collectionTabs -%}
      {%- for block in section.blocks -%}
        {%- assign blockKey = ',' | append: block.id | append: ',' -%}
        {%- if activeBlockIds contains blockKey -%}
          {%- liquid
            assign customIndex = customIndex | plus: 1
            assign anyCollectionAvailable = true
            if collectionAvailable == 0
              assign collectionAvailable = forloop.index
            endif
          -%}
          <li
            class="yv-tab-item {% if customIndex == 1 %}active{% endif %} filter-products"
            {% if section.settings.enable_view_all_button %}
              data-tab-button="tab-btn-{{ section.id }}-{{ forloop.index }}"
            {% endif %}
            data-filter="product-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <button type="button" class="yv-tab-link cursor-pointer">
              {%- if block.settings.heading != blank -%}
                {{- block.settings.heading -}}
              {%- elsif block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
                {{- block.settings.collection.title -}}
              {%- else -%}
                {{- block.settings.content_heading | strip_html | default: 'Products' -}}
              {%- endif -%}
            </button>
          </li>
        {%- endif -%}
      {%- else -%}
        <li class="yv-tab-item active filter-products">
          <span class="yv-tab-link cursor-pointer">{{ 'onboarding.collection_title' | t }}</span>
        </li>
        <li class="yv-tab-item filter-products">
          <span class="yv-tab-link cursor-pointer">{{ 'onboarding.collection_title' | t }}</span>
        </li>
      {%- endfor -%}
      {%- endcapture -%}
      {%- comment -%} Hide the tabs when only one collection block is set {%- endcomment -%}
      {%- if collectionTabs != blank and customIndex != 1 -%}
        <ul class="list-unstyled yv-tabs collection-showcase-pill-tabs">
          {{- collectionTabs -}}
        </ul>
      {%- endif -%}
      {%- if section.settings.enable_view_all_button -%}
        {%- capture viewAllLinks -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign blockKey = ',' | append: block.id | append: ','
              assign viewAllUrl = blank
              if block.settings.collection != blank and block.settings.collection.products_count > 0
                assign viewAllUrl = block.settings.collection.url
              elsif block.settings.button_link != blank
                assign viewAllUrl = block.settings.button_link
              endif
            -%}
            {%- if activeBlockIds contains blockKey and viewAllUrl != blank -%}
              <a
                id="tab-btn-{{ section.id }}-{{ forloop.index }}"
                href="{{ viewAllUrl }}"
                aria-label="{{ 'general.view_all' | t }}"
                class="yv-tab-button collection-showcase-view-link"
              >
                <span class="btn-txt">
                  {%- if section.settings.view_all_button_text != blank -%}
                    {{- section.settings.view_all_button_text -}}
                  {%- else -%}
                    {{- 'general.view_all' | t -}}
                  {%- endif -%}
                </span>
                <span class="collection-showcase-view-link-arrow" aria-hidden="true">
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13.3536 5.35355C13.5488 5.15829 13.5488 4.84171 13.3536 4.64645L10.1716 1.46447C9.97631 1.2692 9.65973 1.2692 9.46447 1.46447C9.2692 1.65973 9.2692 1.97631 9.46447 2.17157L12.2929 5L9.46447 7.82843C9.2692 8.02369 9.2692 8.34027 9.46447 8.53553C9.65973 8.7308 9.97631 8.7308 10.1716 8.53553L13.3536 5.35355ZM0 5.5H13V4.5H0V5.5Z" fill="currentColor"/>
                  </svg>
                </span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if viewAllLinks != blank -%}
          <div class="yv-tab-btn-pane" data-tab-active="tab-btn-{{ section.id }}-{{ collectionAvailable }}">
            {{- viewAllLinks -}}
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- comment -%} Only render the right column when it has content {%- endcomment -%}
    {%- if headerRightContent != blank -%}
      <div class="col-12 col-md-5 collection-showcase-header-right">
        {{- headerRightContent -}}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_collection_body -%}
  <div class="row no-gutters align-items-center collection-showcase-body">
    <div class="col-12 col-md-6 collection-showcase-image-col">
      <div class="yv-imgbox-container collection-showcase-image yv-tabbed-collection-filter-items">
        {%- if anyCollectionAvailable -%}
          {%- assign panelIndex = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign blockKey = ',' | append: block.id | append: ',' -%}
            {%- if activeBlockIds contains blockKey -%}
              {%- liquid
                assign panelIndex = panelIndex | plus: 1
                if block.settings.collection != blank and block.settings.collection.products_count > 0
                  assign collImage = block.settings.collection.featured_image
                else
                  assign collImage = block.settings.product_list.first.featured_image
                endif
                if block.settings.collection_image != blank
                  assign collImage = block.settings.collection_image
                endif
              -%}
              <div
                class="yv-img-content filter-slide product-{{ block.id }}{% if panelIndex == 1 %} active{% endif %}"
                data-filter-item="product-{{ block.id }}"
                {% unless panelIndex == 1 %}style="display:none"{% endunless %}
              >
                {%- unless useAspectImage -%}<div class="image-wrapper" style="padding-bottom:{{ imageHeight | default: 100 }}%;">{%- endunless -%}
                  {%- if collImage != blank -%}
                    {%- render 'lazy-image', image: collImage, sizes: '[400,500,600,700,800,900,1000]' -%}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                {%- unless useAspectImage -%}</div>{%- endunless -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="yv-img-content filter-slide active">
            {%- unless useAspectImage -%}<div class="image-wrapper" style="padding-bottom:{{ imageHeight | default: 100 }}%;">{%- endunless -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- unless useAspectImage -%}</div>{%- endunless -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="col-12 col-md-6 collection-showcase-content-col">
      <div class="collection-showcase-content yv-tabbed-collection-filter-items">
        {%- if anyCollectionAvailable -%}
          {%- assign panelIndex = 0 -%}
          {%- for block in section.blocks -%}
            {%- assign blockKey = ',' | append: block.id | append: ',' -%}
            {%- if activeBlockIds contains blockKey -%}
              {%- liquid
                assign panelIndex = panelIndex | plus: 1
                assign ctaUrl = block.settings.button_link
                if ctaUrl == blank and block.settings.collection != blank and block.settings.collection.products_count > 0
                  assign ctaUrl = block.settings.collection.url
                endif
              -%}
              <div
                class="collection-showcase-content-panel filter-slide product-{{ block.id }}{% if panelIndex == 1 %} active{% endif %}"
                data-filter-item="product-{{ block.id }}"
                {% unless panelIndex == 1 %}style="display:none"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.subheading != blank -%}
                  <p class="heading-subtitle">{{ block.settings.subheading }}</p>
                {%- endif -%}
                {%- if block.settings.badge_text != blank -%}
                  <span class="collection-showcase-badge">
                    <span class="collection-showcase-badge-dot" aria-hidden="true"></span>
                    {{- block.settings.badge_text -}}
                  </span>
                {%- endif -%}
                {%- if block.settings.content_heading != blank -%}
                  <{{ section.settings.content_seo_heading }} class="section-heading-title {{ section.settings.content_heading_size }}">
                    {{- block.settings.content_heading -}}
                  </{{ section.settings.content_seo_heading }}>
                {%- endif -%}
                {%- if block.settings.description != blank -%}
                  <p class="collection-showcase-content-desc text-large">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block.settings.button_text != blank and ctaUrl != blank -%}
                  <a
                    href="{{ ctaUrl }}"
                    class="button {{ section.settings.button_size }}-btn {{ section.settings.mobile_button_size }}-btn collection-showcase-cta"
                  >
                    {% if settings.buttonAnimation == 'animated-arrow' %}
                      <span class="btn-animated-arrow"><svg fill="none" viewBox="0 0 8 8">
                        <path fill="currentColor" fill-rule="evenodd" d="M0 0h8v8H7V1.707L1.354 7.354 1 7.707.293 7l.353-.354L6.293 1H0V0Z" clip-rule="evenodd"></path>
                      </svg></span>
                    {% endif %}
                    <span class="btn-txt">{{- block.settings.button_text -}}</span>
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <div class="collection-showcase-content-panel filter-slide active">
            <p class="heading-subtitle">{{ 'onboarding.collection_title' | t }}</p>
            <{{ section.settings.content_seo_heading }} class="section-heading-title {{ section.settings.content_heading_size }}">{{ 'onboarding.collection_title' | t }}</{{ section.settings.content_seo_heading }}>
            <p class="collection-showcase-content-desc text-large">{{ 'onboarding.no_content' | t }}</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- endif -%}

  <div class="collection-showcase-products-wrapper">
    <div
      class="yv-collection-product-grid column-count-{{ section.settings.products_per_row }} yv-tabbed-collection-filter-items product-grid-stacked{% if section.settings.enable_swipe %} mobile-swipe{% endif %}"
      tabindex="0"
      data-filter
    >
      {%- if anyCollectionAvailable -%}
        {%- liquid
          assign panelIndex = 0
          for block in section.blocks
            assign blockKey = ',' | append: block.id | append: ','
            if activeBlockIds contains blockKey
              assign panelIndex = panelIndex | plus: 1
              if block.settings.collection != blank and block.settings.collection.products_count > 0
                assign blockProducts = block.settings.collection.products
                assign formSuffix = block.settings.collection.handle
              else
                assign blockProducts = block.settings.product_list
                assign formSuffix = block.id
              endif
              assign mainAttr = 'data-filter-item="product-' | append: block.id | append: '"'
              if panelIndex == 1
                assign mainClass = 'filter-slide active product-' | append: block.id
              else
                assign mainAttr = mainAttr | append: ' style="display:none"'
                assign mainClass = 'filter-slide product-' | append: block.id
              endif
              for product in blockProducts limit: section.settings.products_count
                assign productFormId = 'product-form-' | append: section.id | append: forloop.index | append: '-' | append: formSuffix
                if settings.enable_animation
                  assign delay = 50 | times: forloop.index
                  assign animationAttr = 'data-aos="fade-up" data-aos-delay="' | append: delay | append: '"'
                else
                  assign animationAttr = ''
                endif
                render 'product-grid', product: product, section: section, productFormId: productFormId, tabbedCollection: true, productClasses: mainClass, mainAttr: mainAttr, animationAttr: animationAttr, customRadius: true
              endfor
            endif
          endfor
        -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_count) -%}
          <div class="yv-product-card product-grid-layout-rounded filter-slide active">
            <div class="animated-grid">
              <div class="yv-product-card-img">
                {%- if settings.product_image_style != 'aspect' -%}
                  <div class="image-wrapper no-product-image" style="padding-bottom:{{- productImageRatio -}}%">
                {%- endif -%}
                {%- capture current -%}{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
                {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                {%- if settings.product_image_style != 'aspect' -%}
                  </div>
                {%- endif -%}
              </div>
              <div class="yv-product-information {{ settings.product_grid_content_alignment }}">
                <span class="yv-product-title">{{ 'onboarding.product_title' | t }}</span>
                <div class="yv-prizebox" data-saved="true" data-saved-style="percentage" data-price-wrapper="">
                  <span class="yv-product-price">{{ 1999 | money }}</span>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
<style>
  #shopify-section-{{ section.id }}.shopify-section {
    {% if section.settings.enable_top_border %}
      border-top: 1px {{ section.settings.border_style }} var(--primaryBorderColor);
    {% endif %}
    {% if section.settings.enable_bottom_border %}
      border-bottom: 1px {{ section.settings.border_style }} var(--primaryBorderColor);
    {% endif %}
    background: var(--{{- section.settings.bgcolor -}}ColorBody);
    padding-top: {{ section.settings.top_space_desktop }}px;
    padding-bottom: {{ section.settings.bottom_space_desktop }}px;
    {%- unless section.settings.bgcolor == 'primary' or section.settings.bgcolor == 'gradient' -%}
    --colorTextBody: var(--{{- section.settings.bgcolor -}}colorTextBody);
    --heading_color: var(--{{- section.settings.bgcolor -}}_heading_color);
    --subheading_color: var(--{{- section.settings.bgcolor -}}_subheading_color);
    --primaryColorBody: var(--{{- section.settings.bgcolor -}}ColorBody);
    --colorLightTextBody: var(--{{- section.settings.bgcolor -}}ColorLightTextBody);
    --colorXlightTextBody: var(--{{- section.settings.bgcolor -}}ColorXlightTextBody);
    --primaryBorderColor: var(--{{- section.settings.bgcolor -}}BorderColor);
    {%- endunless -%}
    {% if section.settings.highlight_text_gradient != blank %}
      --highlightTextColor: {{ section.settings.highlight_text_gradient }};
    {% else %}
      --highlightTextColor: {{ section.settings.highlight_text_color }};
    {% endif %}
  }
  #shopify-section-{{ section.id }}.shopify-section .collection-showcase-header .section-heading-title {
    --fontSize: var(--{{ section.settings.heading_size }});
  }
  {% if section.settings.subheading_color != blank %}
    #shopify-section-{{ section.id }}.shopify-section .collection-showcase-header .heading-subtitle {
      color: {{ section.settings.subheading_color }} !important;
    }
  {% endif %}
  {% if section.settings.description_color != blank %}
    #shopify-section-{{ section.id }}.shopify-section .collection-showcase-description,
    #shopify-section-{{ section.id }}.shopify-section .collection-showcase-description * {
      color: {{ section.settings.description_color }} !important;
    }
  {% endif %}
  #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel .section-heading-title {
    --fontSize: var(--{{ section.settings.content_heading_size }});
  }
  #shopify-section-{{ section.id }}.shopify-section .collection-showcase-image .yv-img-content {
    --layoutRadius: {{ section.settings.image_radius_desktop }}px;
  }
  {% for block in section.blocks %}
    {% if block.settings.subheading_color != blank %}
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .heading-subtitle {
        color: {{ block.settings.subheading_color }} !important;
      }
    {% endif %}
    {% if block.settings.content_heading_color != blank %}
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .section-heading-title,
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .section-heading-title * {
        color: {{ block.settings.content_heading_color }} !important;
      }
    {% endif %}
    {% if block.settings.description_color != blank %}
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .collection-showcase-content-desc,
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .collection-showcase-content-desc * {
        color: {{ block.settings.description_color }} !important;
      }
    {% endif %}
    {% if block.settings.badge_dot_color != blank %}
      #shopify-section-{{ section.id }}.shopify-section .collection-showcase-content-panel.product-{{ block.id }} .collection-showcase-badge-dot {
        background: {{ block.settings.badge_dot_color }} !important;
      }
    {% endif %}
  {% endfor %}
  {% if section.blocks.size > 0 %}
    {% for block in section.blocks %}
      #shopify-section-{{ section.id }}.shopify-section [data-tab-active="tab-btn-{{ section.id }}-{{ forloop.index }}"] #tab-btn-{{ section.id }}-{{ forloop.index }}{% unless forloop.last %},{% endunless %}
    {% endfor %}{
      display: inline-flex !important;
    }
  {% endif %}
  #shopify-section-{{ section.id }}.shopify-section .yv-collection-product-grid {
    --layoutRadius: {{ section.settings.product_grid_radius_desktop }}px;
    --product-spacing: {{ section.settings.product_grid_spacing_desktop }}px;
  }
  @media only screen and (max-width: 767px) {
    #shopify-section-{{ section.id }}.shopify-section {
      padding-top: {{ section.settings.top_space_mobile }}px;
      padding-bottom: {{ section.settings.bottom_space_mobile }}px;
    }
    #shopify-section-{{ section.id }}.shopify-section .collection-showcase-image .yv-img-content {
      --layoutRadius: {{ section.settings.image_radius_mobile }}px;
    }
    #shopify-section-{{ section.id }}.shopify-section .yv-collection-product-grid {
      --layoutRadius: {{ section.settings.product_grid_radius_mobile }}px;
      --product-spacing: {{ section.settings.product_grid_spacing_mobile }}px;
    }
    {%- if section.settings.mobile_products_visible == '1.5' %}
      #shopify-section-{{ section.id }}.shopify-section .yv-collection-product-grid .yv-product-card {
        max-width: 66.66%;
        flex: 0 0 66.66%;
        width: 66.66%;
      }
    {%- endif %}
  }
  {% if section.settings.section_visibility == 'large' %}
    @media (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        display: none !important;
      }
    }
  {% elsif section.settings.section_visibility == 'small' %}
    @media (min-width: 768px) {
      #shopify-section-{{ section.id }} {
        display: none !important;
      }
    }
  {% endif %}
</style>
{%- endif -%}
{% schema %}
{
  "name": "t:sections.collection-showcase.name",
  "tag": "section",
  "class": "collection-showcase-section",
  "max_blocks": 6,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:common.header.section_border.label"
    },
    {
      "type": "checkbox",
      "id": "enable_top_border",
      "label": "t:common.enable_top_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_bottom_border",
      "label": "t:common.enable_bottom_border.label",
      "default": false
    },
    {
      "type": "select",
      "id": "border_style",
      "default": "solid",
      "label": "t:common.border_style.label",
      "options": [
        { "value": "solid", "label": "t:common.border_style.options.solid.label" },
        { "value": "dashed", "label": "t:common.border_style.options.dashed.label" }
      ]
    },
    {
      "type": "header",
      "content": "t:common.header.text_section.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.collection-showcase.settings.subheading.label",
      "default": "Collection No.01"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "t:sections.collection-showcase.settings.subheading_color.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.collection-showcase.settings.heading.label",
      "info": "t:common.highlight_text_and_break_text.info",
      "default": "The Collection Name"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "t:common.highlight_text_color.label",
      "default": "#000000",
      "visible_if": "{{ section.settings.heading contains '<strong>' or section.settings.heading contains '[' and section.settings.heading contains ']' }}"
    },
    {
      "type": "color_background",
      "id": "highlight_text_gradient",
      "label": "t:common.highlight_text_gradient.label",
      "info": "t:common.highlight_text_gradient.info",
      "default": "linear-gradient(90deg, #A678C8 0%, #718CC7 48.08%, #639A47 100%)",
      "visible_if": "{{ section.settings.heading contains '<strong>' or section.settings.heading contains '[' and section.settings.heading contains ']' }}"
    },
    {
      "type": "select",
      "id": "highlight_font",
      "default": "body",
      "label": "t:common.highlight_font.label",
      "options": [
        { "value": "body", "label": "t:common.highlight_font.options.body.label" },
        { "value": "heading", "label": "t:common.highlight_font.options.heading.label" },
        { "value": "accent", "label": "t:common.highlight_font.options.accent.label" }
      ]
    },
    {
      "type": "select",
      "id": "seo_heading",
      "label": "t:common.header.heading_tag.label",
